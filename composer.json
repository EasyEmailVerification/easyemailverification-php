{
    "name": "easyemailverification/php-sdk",
    "description": "Official PHP client for the Easy Email Verification API: verify email addresses one by one, in batches of 50 or as bulk lists.",
    "type": "library",
    "license": "MIT",
    "keywords": ["email verification", "email validation", "email checker", "verify email", "bounce", "email list cleaning", "disposable email", "catch-all"],
    "homepage": "https://www.easyemailverification.com/en-US/api",
    "authors": [
        { "name": "Easy Email Verification", "email": "support@easyemailverification.com", "homepage": "https://www.easyemailverification.com" }
    ],
    "support": {
        "email": "support@easyemailverification.com",
        "docs": "https://www.easyemailverification.com/en-US/api/reference",
        "issues": "https://github.com/EasyEmailVerification/easyemailverification-php/issues",
        "source": "https://github.com/EasyEmailVerification/easyemailverification-php"
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11"
    },
    "autoload": {
        "psr-4": { "EasyEmailVerification\\": "src/EasyEmailVerification/" },
        "classmap": ["src/EasyEmailVerificationClient.php"]
    },
    "autoload-dev": {
        "psr-4": { "EasyEmailVerification\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit tests"
    },
    "config": { "sort-packages": true }
}
